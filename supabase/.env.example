# Copy to supabase/.env.local (git-ignored) and fill in. Never commit real values.
# Run locally with:
#   npx supabase functions serve narrate-report --env-file supabase/.env.local
# or: ANTHROPIC_API_KEY=... npx supabase functions serve narrate-report
# [edge_runtime.secrets] in config.toml reads these from the shell / --env-file
# when serve starts.
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=claude-opus-5-5
